{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wayne-Ch/fl-model-onboarding-concept/contracts/recipe-selection-policy.schema.json",
  "title": "Recipe selection policies",
  "type": "object",
  "required": [
    "schema_version",
    "policies"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/policy"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "target_device": {
      "type": "string",
      "enum": [
        "cpu"
      ]
    },
    "quantization": {
      "type": "string",
      "enum": [
        "int4"
      ]
    },
    "eligibility_trigger": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "retryable_optimized_structural_regression"
      ]
    },
    "quantization_override": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "block_size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_index",
        "candidate_id",
        "description",
        "quantization_override",
        "eligibility_trigger"
      ],
      "properties": {
        "candidate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "quantization_override": {
          "$ref": "#/$defs/quantization_override"
        },
        "eligibility_trigger": {
          "$ref": "#/$defs/eligibility_trigger"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "policy_id",
        "version",
        "target_device",
        "quantization",
        "max_candidates",
        "candidates"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "target_device": {
          "$ref": "#/$defs/target_device"
        },
        "quantization": {
          "$ref": "#/$defs/quantization"
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
