{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wayne-Ch/fl-model-onboarding-concept/contracts/quality-validation.schema.json",
  "title": "Quality validation profiles",
  "type": "object",
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "task": {
      "type": "string",
      "enum": [
        "text-generation"
      ]
    },
    "prompt_category": {
      "type": "string",
      "enum": [
        "arithmetic",
        "factual-recall",
        "instruction-following",
        "output-format"
      ]
    },
    "deterministic_inference": {
      "type": "object",
      "required": [
        "temperature",
        "seed",
        "max_tokens"
      ],
      "properties": {
        "temperature": {
          "type": "number"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "expected_constraints": {
      "type": "object",
      "properties": {
        "exact_match": {
          "type": "string",
          "minLength": 1
        },
        "allowed_answers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbidden_tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "relevance_keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_json_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "max_words": {
          "type": "integer",
          "minimum": 1
        },
        "min_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_repetition_ratio": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "max_consecutive_token_repeats": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "required": [
        "prompt_id",
        "category",
        "prompt",
        "expected"
      ],
      "properties": {
        "prompt_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/prompt_category"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "$ref": "#/$defs/expected_constraints"
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "profile_id",
        "version",
        "task",
        "deterministic_inference",
        "prompts"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "$ref": "#/$defs/task"
        },
        "deterministic_inference": {
          "$ref": "#/$defs/deterministic_inference"
        },
        "prompts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/prompt"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
